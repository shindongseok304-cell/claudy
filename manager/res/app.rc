#include <winuser.h>
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041204B0"
    BEGIN
      VALUE "FileDescription", "Claudy Manager"
      VALUE "FileVersion", "0.4.0"
      VALUE "ProductName", "Claudy"
      VALUE "ProductVersion", "0.4.0"
      VALUE "OriginalFilename", "ClaudyManager.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0412, 1200
  END
END
